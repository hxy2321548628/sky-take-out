# ============================================================
# 本地开发环境变量（复制为 .env 后使用：cp .env.example .env）
# Taskfile 与 docker compose 共用这一份，.env 不进版本库
# ============================================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=sky_take_out
MYSQL_PORT=3306

# ---------- Redis ----------
REDIS_PORT=6379

# ---------- MinIO（替代阿里云 OSS，本地跑通文件上传）----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=sky-take-out

# ---------- 后端 ----------
SERVER_PORT=8080
SKY_JWT_ADMIN_SECRET=change-me-to-a-random-32-byte-secret
SKY_JWT_USER_SECRET=change-me-to-another-random-32-byte-secret

# ---------- 管理端 ----------
ADMIN_WEB_PORT=8888
