# ============================================================
# 兼容层：真正的命令定义都在 Taskfile.yml，这里只做转发
#   make up        ==  task up
#   make           ==  task --list
# 之所以保留：习惯敲 make 的人（以及部分 CI 脚本）不用改肌肉记忆
# ============================================================
.DEFAULT_GOAL := help

%:
	@task $@

help:
	@task --list
